# Fortuna production settings: ~/services/fortuna/.env on the home server
# (mode 600). devbot links it into every release folder. No real values here.
#
# `devbot adopt fortuna 66` fills this file from the old Portainer stack.
# Generate fresh secrets with: openssl rand -base64 32

# Host folder for the Postgres data, statement files and the Hermes inbox
# (postgres/, statements/, inbox/).
FORTUNA_DATA_DIR=/srv/fortuna

# Database. Keep these stable: they must match the existing data directory.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=personal_finance

# Web app
NEXTAUTH_URL=https://fortuna.delishad.com
NEXTAUTH_SECRET=
# Extra Server Action origins (host[:port], comma-separated), baked in at
# build time. fortuna.delishad.com is always allowed.
SERVER_ACTION_ALLOWED_ORIGINS=fortuna.delishad.com

# Shared between the frontend, data service, file parser and chat worker.
INTERNAL_SERVICE_TOKEN=
# Signs import commit tokens (data service and chat worker).
COMMIT_TOKEN_SECRET=

# Hermes MCP gateway (127.0.0.1:4002).
# FINANCE_API_TOKEN: create in Fortuna under Settings -> API Tokens.
# MCP_CLIENT_TOKEN: an independent random value Hermes sends as its Bearer token.
FINANCE_API_TOKEN=
MCP_CLIENT_TOKEN=
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.2

# Chat
CHAT_ENABLED=false
# 32 random bytes, base64: openssl rand -base64 32
CHAT_ENCRYPTION_KEY_V1=
CHAT_WORKER_CONCURRENCY=2

# Set by devbot on each deploy (the commit being deployed); don't put it here.
# REVISION=

# Left over from the Portainer / Docker Hub setup. Accepted but ignored:
# images are now built on the server and tagged fortuna-<service>:<commit>,
# and the ports are fixed at 127.0.0.1:3040 (app) and 127.0.0.1:4002 (MCP).
# DOCKERHUB_NAMESPACE=
# IMAGE_TAG=
# DATA_IMAGE_TAG=
# CHAT_IMAGE_TAG=
# FRONTEND_IMAGE_TAG=
# MCP_IMAGE_TAG=
# APP_BIND=
# APP_PORT=
# MCP_BIND=
# MCP_PORT=
