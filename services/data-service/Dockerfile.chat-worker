FROM node:22.23.4-bookworm-slim AS build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package*.json tsconfig.json ./
COPY prisma ./prisma
RUN npm ci && npx prisma generate
COPY src ./src
RUN npm run build && npm prune --omit=dev
FROM node:22.23.4-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/* \
 && npm install -g @openai/codex@0.155.0-alpha.16.3 \
 && mkdir -p /data/chat-codex /data/statements && chown -R node:node /data
WORKDIR /app
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
USER node
ENV NODE_ENV=production CHAT_CODEX_ROOT=/data/chat-codex CHAT_WORKER_PORT=4003
EXPOSE 4003
CMD ["node","dist/modules/chat/worker.js"]
